# ── Core ────────────────────────────────────────────────────────────
# Backend
# POSTGRES_PASSWORD drives both the Postgres container and DATABASE_URL
# (see docker-compose.yml). vps_setup.sh fills it in automatically.
POSTGRES_PASSWORD=voxdesk
DATABASE_URL=postgresql+asyncpg://voxdesk:voxdesk@localhost:5432/voxdesk
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
JWT_SECRET=change-me-in-production-min-32-bytes!
JWT_EXPIRES_MIN=1440
CORS_ORIGINS=http://localhost:3000
# Production only (docker-compose.prod.yml): domain Caddy serves the API on.
API_DOMAIN=api.yourdomain.com

# ── Providers (mock = fully functional placeholder, no credentials) ─
LLM_PROVIDER=mock            # mock | qwen
STT_PROVIDER=mock            # mock | whisper
TTS_PROVIDER=mock            # mock | kokoro
EMBEDDING_PROVIDER=mock      # mock | qwen
TELEPHONY_PROVIDER=mock      # mock | telnyx
VOICE_ENGINE=mock            # mock | dograh
CALENDAR_PROVIDER=mock       # mock | google | outlook
CRM_PROVIDER=mock            # mock | hubspot | gohighlevel
STORAGE_PROVIDER=local       # local | minio

# ── Credentials (fill in AFTER implementation — leave placeholders) ─
TELNYX_API_KEY=placeholder
TELNYX_PUBLIC_KEY=placeholder
TELNYX_CONNECTION_ID=placeholder
DOGRAH_URL=http://localhost:8010
DOGRAH_API_KEY=placeholder
QWEN_API_BASE=http://localhost:8020/v1
QWEN_API_KEY=placeholder
WHISPER_URL=http://localhost:8030
KOKORO_URL=http://localhost:8040
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder
OUTLOOK_CLIENT_ID=placeholder
OUTLOOK_CLIENT_SECRET=placeholder
HUBSPOT_API_KEY=placeholder
GOHIGHLEVEL_API_KEY=placeholder
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=placeholder
MINIO_SECRET_KEY=placeholder

# ── Frontend (apps/web/.env.local) ──────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
